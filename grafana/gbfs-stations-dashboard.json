{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "One row per station: occupancy against capacity, the service flags, and the vehicle mix. Pick the stations you care about; the list is deliberately not an All, because a row for each of 293 stations is unreadable.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "gbfs"
      ],
      "targetBlank": false,
      "title": "GBFS dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "gbfs",
    "bikeshare",
    "prometheus"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "query_result(last_over_time(gbfs_system_info[24h]))",
        "hide": 0,
        "includeAll": false,
        "label": "System",
        "multi": false,
        "name": "system",
        "options": [],
        "query": {
          "qryType": 3,
          "query": "query_result(last_over_time(gbfs_system_info[24h]))",
          "refId": "system"
        },
        "refresh": 1,
        "regex": "/system=\"(?<value>[^\"]+)\".*system_name=\"(?<text>[^\"]+)\"/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "query_result(last_over_time(gbfs_station_info{system=\"$system\"}[24h]))",
        "hide": 0,
        "includeAll": false,
        "label": "Station",
        "multi": true,
        "name": "station",
        "options": [],
        "query": {
          "qryType": 3,
          "query": "query_result(last_over_time(gbfs_station_info{system=\"$system\"}[24h]))",
          "refId": "station"
        },
        "refresh": 2,
        "regex": "/station_id=\"(?<value>[^\"]+)\".*station_name=\"(?<text>[^\"]+)\"/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "GBFS stations",
  "uid": "gbfs-stations",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 22,
      "panels": [],
      "title": "The selection",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The stations you picked, added together as one pool. Read this before the rows below: a neighbourhood can be healthy while one station in it is empty. The bands and the capacity line mean the same as in each row.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 45,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Vehicles"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Free docks"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unavailable (derived)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#8E8E8E",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Capacity"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "group": "A",
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    8,
                    6
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "text",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "id": 20,
      "interval": "1m",
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(gbfs_station_vehicles_available{system=~\"$system\", station_id=~\"$station\"})",
          "instant": false,
          "legendFormat": "Vehicles",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(gbfs_station_docks_available{system=~\"$system\", station_id=~\"$station\"})",
          "instant": false,
          "legendFormat": "Free docks",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "clamp_min(\n  sum(gbfs_station_capacity{system=~\"$system\", station_id=~\"$station\"})\n  - (sum(gbfs_station_vehicles_available{system=~\"$system\", station_id=~\"$station\"}) or vector(0))\n  - (sum(gbfs_station_docks_available{system=~\"$system\", station_id=~\"$station\"}) or vector(0))\n, 0)",
          "instant": false,
          "legendFormat": "Unavailable (derived)",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(gbfs_station_capacity{system=~\"$system\", station_id=~\"$station\"})",
          "instant": false,
          "legendFormat": "Capacity",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "The stations you picked, combined",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "How many of the three service flags are off at each station you picked. A station that publishes no flag at all gets no row here, so do not read a missing row as healthy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "in service"
                },
                "1": {
                  "color": "yellow",
                  "index": 1,
                  "text": "one flag off"
                },
                "2": {
                  "color": "orange",
                  "index": 2,
                  "text": "two flags off"
                },
                "3": {
                  "color": "red",
                  "index": 3,
                  "text": "out of service"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 21,
      "options": {
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count by (station_id) (\n  {__name__=~\"gbfs_station_(installed|renting|returning)\", system=~\"$system\", station_id=~\"$station\"} == 0\n)\nor (\n  count by (station_id) (\n    {__name__=~\"gbfs_station_(installed|renting|returning)\", system=~\"$system\", station_id=~\"$station\"}\n  ) * 0\n)",
          "instant": false,
          "legendFormat": "{{station_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Service, per station",
      "type": "state-timeline"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 10,
      "panels": [],
      "repeat": "station",
      "title": "${station:text}",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Vehicles a rider can take, stacked on the docks that accept a vehicle, then on the space that neither holds a rentable vehicle nor accepts one. The three together reach the capacity line. The third band is derived by subtraction, because no GBFS field states it: for a car sharing bay it is mostly cars out on rental, and for a docked bike station it is broken docks or bikes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 45,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Vehicles"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Free docks"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unavailable (derived)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#8E8E8E",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Capacity"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "group": "A",
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    8,
                    6
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "text",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 15,
        "x": 0,
        "y": 9
      },
      "id": 1,
      "interval": "1m",
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "gbfs_station_vehicles_available{system=~\"$system\", station_id=\"$station\"}",
          "instant": false,
          "legendFormat": "Vehicles",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "gbfs_station_docks_available{system=~\"$system\", station_id=\"$station\"}",
          "instant": false,
          "legendFormat": "Free docks",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "clamp_min(\n  gbfs_station_capacity{system=~\"$system\", station_id=\"$station\"}\n  - (gbfs_station_vehicles_available{system=~\"$system\", station_id=\"$station\"} or vector(0))\n  - (gbfs_station_docks_available{system=~\"$system\", station_id=\"$station\"} or vector(0))\n, 0)",
          "instant": false,
          "legendFormat": "Unavailable (derived)",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "gbfs_station_capacity{system=~\"$system\", station_id=\"$station\"}",
          "instant": false,
          "legendFormat": "Capacity",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Vehicles and space",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The three service flags of this station. A station flat at zero vehicles reads as demand until this panel shows that renting stopped at the same moment, and then it is a fault. A flag the operator omits gets no row.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "no"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "yes"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 15,
        "y": 9
      },
      "id": 2,
      "options": {
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "gbfs_station_installed{system=~\"$system\", station_id=\"$station\"}",
          "instant": false,
          "legendFormat": "Installed",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "gbfs_station_renting{system=~\"$system\", station_id=\"$station\"}",
          "instant": false,
          "legendFormat": "Renting",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "gbfs_station_returning{system=~\"$system\", station_id=\"$station\"}",
          "instant": false,
          "legendFormat": "Returning",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Service",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "What stands at this station right now, by form factor and drive. This needs a module with per_vehicle_type set.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "min": 0,
          "unit": "short",
          "decimals": 0,
          "noValue": "This system reports no per-type breakdown at stations.",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 19,
        "y": 9
      },
      "id": 3,
      "options": {
        "displayMode": "basic",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (form_factor, propulsion_type) (\n  gbfs_station_type_vehicles_available{system=~\"$system\", station_id=\"$station\"}\n)",
          "instant": true,
          "legendFormat": "{{form_factor}} · {{propulsion_type}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Vehicle mix now",
      "type": "bargauge"
    }
