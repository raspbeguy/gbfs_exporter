{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "One panel per station, showing occupancy over time. Selecting every station of a large system draws one panel per station, so a system with hundreds of stations draws hundreds of panels.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "gbfs",
    "bikeshare",
    "prometheus"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "query_result(last_over_time(gbfs_system_info[24h]))",
        "hide": 0,
        "includeAll": false,
        "label": "System",
        "multi": false,
        "name": "system",
        "options": [],
        "query": {
          "qryType": 3,
          "query": "query_result(last_over_time(gbfs_system_info[24h]))",
          "refId": "system"
        },
        "refresh": 1,
        "regex": "/system=\"(?<value>[^\"]+)\".*system_name=\"(?<text>[^\"]+)\"/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "query_result(last_over_time(gbfs_station_info{system=\"$system\"}[24h]))",
        "hide": 0,
        "includeAll": true,
        "label": "Station",
        "multi": true,
        "name": "station",
        "options": [],
        "query": {
          "qryType": 3,
          "query": "query_result(last_over_time(gbfs_station_info{system=\"$system\"}[24h]))",
          "refId": "station"
        },
        "refresh": 2,
        "regex": "/station_id=\"(?<value>[^\"]+)\".*station_name=\"(?<text>[^\"]+)\"/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "GBFS stations",
  "uid": "gbfs-stations",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Vehicles a rider can take, stacked on the docks that accept a vehicle. The two together make the parking positions that report a state, so the height is the usable size of the station and the split is its occupancy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 45,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Vehicles"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Free docks"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "1m",
      "maxPerRow": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "repeat": "station",
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "gbfs_station_vehicles_available{system=\"$system\", station_id=\"$station\"}",
          "instant": false,
          "legendFormat": "Vehicles",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "gbfs_station_docks_available{system=\"$system\", station_id=\"$station\"}",
          "instant": false,
          "legendFormat": "Free docks",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "${station:text}",
      "type": "timeseries"
    }
  ]
}
